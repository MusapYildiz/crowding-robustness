   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 3. COCO İndir\n", "> ⚠️ ~18GB. Colab disk alanı yeterliyse çalıştır.\n", "> Alternatif: Google Drive'a önceden yükle, mount et."]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["# Seçenek A: Direkt indir\n", "# !bash scripts/download_coco.sh\n\n", "# Seçenek B: Google Drive mount\n", "from google.colab import drive\n", "drive.mount('/content/drive')\n\n", "# COCO'yu Drive'dan symlink et (Drive'a önceden yüklediysen)\n", "COCO_DRIVE_PATH = '/content/drive/MyDrive/coco'  # <-- kendi yolunu gir\n", "import os\n", "if os.path.exists(COCO_DRIVE_PATH) and not os.path.exists('coco'):\n", "    os.symlink(COCO_DRIVE_PATH, 'coco')\n", "    print('COCO Drive'\''dan bağlandı.')\n", "elif os.path.exists('coco'):\n", "    print('COCO zaten mevcut.')\n", "else:\n", "    print('COCO bulunamadı. Seçenek A'\''yı deneyin.')"]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 4. Veri Hazırla"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["# Instance kırpma + split\n", "!python data/prepare_dataset.py --config configs/config.yaml"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["# Crowding kompozitlerini oluştur (leakage kontrolü dahil)\n", "!python data/build_composites.py --config configs/config.yaml"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["# Örnek görsellere bak\n", "import matplotlib.pyplot as plt\n", "import cv2, glob, random\n\n", "fig, axes = plt.subplots(2, 4, figsize=(14, 7))\n", "fig.suptitle('Üst: Isolation (train) | Alt: Crowded (test, 2°, same_class)')\n\n", "iso_paths   = glob.glob('dataset/train/*/*.png')\n", "crowd_paths = glob.glob('dataset/composites/test/*/same_class/2deg/*.png')\n\n", "for i, ax in enumerate(axes[0]):\n", "    if i < len(iso_paths):\n", "        img = cv2.cvtColor(cv2.imread(random.choice(iso_paths)), cv2.COLOR_BGR2RGB)\n", "        ax.imshow(img); ax.axis('off')\n\n", "for i, ax in enumerate(axes[1]):\n", "    if i < len(crowd_paths):\n", "        img = cv2.cvtColor(cv2.imread(random.choice(crowd_paths)), cv2.COLOR_BGR2RGB)\n", "        ax.imshow(img); ax.axis('off')\n\n", "plt.tight_layout(); plt.show()"]
  },
  {
